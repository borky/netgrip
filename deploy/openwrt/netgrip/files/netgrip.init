#!/bin/sh /etc/rc.common
# netgrip procd init script

START=99
STOP=10

USE_PROCD=1

start_service() {
	# Port comes from UCI so local choices survive package upgrades.
	# Default 8090, not 8080: GL.iNet firmware serves its own web UI on
	# 8080 (#210).
	local port
	port=$(uci -q get netgrip.main.port 2>/dev/null)
	[ -n "$port" ] || port=8090
	# Where this build looks for its own releases. Unset means upstream, so
	# a normal install needs nothing here; a packaged or patched build sets
	# it to the releases it was actually built from.
	local update_repo
	update_repo=$(uci -q get netgrip.main.update_repo 2>/dev/null)
	# FORK: this build is not upstream's, so it must ask its own releases.
	# Accepting an upstream asset here would replace it with a binary that
	# has none of the features below. Override per device with
	# `uci set netgrip.main.update_repo=...`.
	[ -n "$update_repo" ] || update_repo=borky/netgrip
	# HTTPS for the panel itself. Off unless asked for: an upgrade must not
	# change anybody's URL. netgrip.main.https and the https_cert/https_key
	# pair are what Settings already writes when it generates a
	# certificate; without them the binary uses the panel's pair if there
	# is one and otherwise uhttpd's, the same one LuCI serves.
	local https https_cert https_key
	https=$(uci -q get netgrip.main.https 2>/dev/null)
	https_cert=$(uci -q get netgrip.main.https_cert 2>/dev/null)
	https_key=$(uci -q get netgrip.main.https_key 2>/dev/null)
	# The flags are collected in the positional parameters, not in a string.
	# A string has to be expanded unquoted for the flags to be separate
	# arguments, and that also splits a certificate path containing a space,
	# which loses the flag its argument without a word of complaint.
	set --
	if [ -n "$update_repo" ]; then
		set -- -update-repo "$update_repo"
	fi
	case "$https" in
		1|on|true|yes)
			set -- "$@" -https
			if [ -n "$https_cert" ]; then
				set -- "$@" -https-cert "$https_cert"
			fi
			if [ -n "$https_key" ]; then
				set -- "$@" -https-key "$https_key"
			fi
			;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/netgrip -listen 0.0.0.0 -port "$port" "$@"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start() {
	start_service
	# Reapply MAC ACL and storm control rules after boot
	[ -x /usr/libexec/netgrip-restore-rules ] && /usr/libexec/netgrip-restore-rules &
	# Restore the package registry entry after attended sysupgrades (#296):
	# owut/ASU drops packages outside official feeds from the image, files
	# survive via /etc/sysupgrade.conf but the apk/opkg registry does not.
	[ -x /usr/libexec/netgrip-heal-register ] && /usr/libexec/netgrip-heal-register &
}
